{
  "expo": {
    "name": "Perkfy",
    "slug": "perkfy",
    "scheme": "perkfy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E1B4B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.perkfy.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E1B4B"
      },
      "package": "com.perkfy.app",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK"
      ]
    },
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#7C3AED",
      "sounds": [
        "./assets/sounds/alert_chime.wav"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7C3AED",
          "sounds": [
            "./assets/sounds/alert_chime.wav"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "994dbd2e-5e06-4f3b-bf6e-aca8372a8a58"
      }
    },
    "owner": "namza63"
  }
}
