{
  "expo": {
    "name": "Perkfy",
    "slug": "perkfy",
    "scheme": "perkfy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E1B4B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.perkfy.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E1B4B"
      },
      "package": "com.perkfy.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#7C3AED",
      "sounds": [
        "./assets/sounds/alert_chime.wav"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Perkfy to save your gift card vouchers directly to your gallery.",
          "savePhotosPermission": "Allow Perkfy to save your gift card vouchers directly to your gallery."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7C3AED",
          "sounds": [
            "./assets/sounds/alert_chime.wav"
          ]
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7975874630816543~2575911965",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "owner": "perkfy18",
    "extra": {
      "eas": {
        "projectId": "2c1cb697-cfe5-4fd4-b9c8-39a0a8b8c385"
      }
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-7975874630816543~2575911965",
    "ios_app_id": "ca-app-pub-3940256099942544~1458002511"
  }
}
