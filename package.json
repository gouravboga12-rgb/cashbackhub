{
  "name": "cashbackhub-root",
  "version": "1.0.0",
  "description": "CashBack Hub — Unified Single Root Platform",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:web\"",
    "dev:backend": "node backend/src/server.js",
    "dev:web": "cd web && npm start",
    "start": "node backend/src/server.js",
    "build": "cd web && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^9.15.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
