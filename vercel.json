{
  "buildCommand": "cd web && npm install && npm run build",
  "outputDirectory": "web/build",
  "rewrites": [
    {
      "source": "/api/v1/:match*",
      "destination": "http://16.112.230.111/api/v1/:match*"
    },
    {
      "source": "/api/:match*",
      "destination": "http://16.112.230.111/api/v1/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

